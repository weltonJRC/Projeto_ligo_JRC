  <stepSection>
    <steps>
      <step id="Step1" name="Start Script" component="Sytel.StepLibrary.StartScript">
        <params />
        <returnValues />
      </step>
      <step id="Step2" name="Exit Script" component="Sytel.StepLibrary.ExitScript">
        <params>
          <param name="ExitCode" direction="in" value="ok" />
        </params>
        <returnValues />
      </step>
      <step id="Step3" name="HTTP Request" component="Sytel.StepLibrary.HttpRequest">
        <params>
          <param name="Url" direction="in" value="${var:url}?numberchip=${var:numberchip}&amp;template=${var:template}&amp;destination=${var:telefone}&amp;field1=${var:var1}&amp;field2=${var:var2}" />
          <param name="ResultText" direction="out" value="${var:httpResult}" />
        </params>
        <returnValues />
      </step>
      <step id="Step4" name="Extract XML" component="Sytel.StepLibrary.ExtractXml">
        <params>
          <param name="doc" direction="in" value="${var:config}" />
          <param name="Query1" direction="in" value="/config/numberchip/text()" />
          <param name="Query2" direction="in" value="/config/url/text()" />
          <param name="Query4" direction="in" value="/config/getTemplatesUrl/text()" />
          <param name="Result1" direction="out" value="${var:numberchip}" />
          <param name="Result2" direction="out" value="${var:url}" />
          <param name="Result4" direction="out" value="${var:getTemplatesUrl}" />
        </params>
        <returnValues />
      </step>
      <step id="Step5" name="Read Text File" component="Sytel.StepLibrary.ReadTextFile">
        <params>
          <param name="Contents" direction="out" value="${var:config}" />
          <param name="FileName" direction="in" value="config.xml" />
        </params>
        <returnValues />
      </step>
      <step id="Step8" name="Alert Monitor" component="Sytel.StepLibrary.AlertMonitor">
        <params>
          <param name="Message" direction="in" value="${var:url}?numberchip=${var:numberchip}&amp;template=${var:template}&amp;destination=${var:telefone}&amp;field1=${var:var1}&amp;field2=${var:var2}&#xA;" />
          <param name="Facility" direction="in" value="Scripter2" />
          <param name="Severity" direction="in" value="2" />
        </params>
        <returnValues />
      </step>
      <step id="Step9" name="Send SDMP Message" component="Sytel.StepLibrary.SendSDMP">
        <params>
          <param name="FullMessage" direction="in" value="CG:CA:MC\TD${sys:TenantID}\CN${sys:CampaignName}\SI${sys:NewGUID}\TN${var:telefone}\MSChat\AN${sys:AgentName}" />
        </params>
        <returnValues />
      </step>
      <step id="Step6" name="Send Chat To Customer" component="Sytel.TextProcessing.SendChatToCustomer">
        <params>
          <param name="CustomerID" direction="in" value="${var:telefone}" />
          <param name="MessageText" direction="in" value="${var:phrase}" />
        </params>
        <returnValues />
      </step>
      <step id="Step7" name="HTTP Request" component="Sytel.StepLibrary.HttpRequest">
        <params>
          <param name="Url" direction="in" value="${var:getTemplatesUrl}?numberchip=${var:numberchip}" />
          <param name="ResultText" direction="out" value="${var:templateCollection}" />
        </params>
        <returnValues />
      </step>
      <step id="Step10" name="Alert Monitor" component="Sytel.StepLibrary.AlertMonitor">
        <params>
          <param name="Message" direction="in" value="getTemplatesUrl ${var:getTemplatesUrl}?numberchip=${var:numberchip}" />
          <param name="Facility" direction="in" value="Scripter2" />
          <param name="Severity" direction="in" value="2" />
        </params>
        <returnValues />
      </step>
      <step id="Step11" name="TemplateSelector" component="Screens.TemplateSelector">
        <params>
          <param name="ComboTemplate_Collection" direction="in" value="${var:templateCollection}" />
          <param name="ComboTemplate_Collection" direction="out" value="${var:templateCollection}" />
          <param name="ComboTemplate_Selection" direction="in" value="${var:templatexml}" />
          <param name="ComboTemplate_Selection" direction="out" value="${var:templatexml}" />
          <param name="phone" direction="in" value="${var:telefone}" />
          <param name="phone" direction="out" value="${var:telefone}" />
          <param name="campo1" direction="in" value="${var:var1}" />
          <param name="campo1" direction="out" value="${var:var1}" />
        </params>
        <returnValues />
      </step>
      <step id="Step12" name="Extract XML" component="Sytel.StepLibrary.ExtractXml">
        <params>
          <param name="doc" direction="in" value="${var:templateCollection}" />
          <param name="Query1" direction="in" value="/collection/entries/entry[@key=&quot;${var:template}&quot;]/text()" />
          <param name="Result1" direction="out" value="${var:phrase}" />
        </params>
        <returnValues />
      </step>
      <step id="Step13" name="Extract XML" component="Sytel.StepLibrary.ExtractXml">
        <params>
          <param name="doc" direction="in" value="${var:templatexml}" />
          <param name="Query1" direction="in" value="/selection/items/item/text()" />
          <param name="Result1" direction="out" value="${var:template}" />
        </params>
        <returnValues />
      </step>
      <step id="Step14" name="End Call Transaction" component="Sytel.StepLibrary.EndCallTransaction">
        <params>
          <param name="AgentOutcome" direction="in" value="105" />
        </params>
        <returnValues />
      </step>
      <step id="Step15" name="String Substitute" component="Sytel.StepLibrary.StringSubstituteStep">
        <params>
          <param name="InputString" direction="in" value="${var:phrase}" />
          <param name="SearchString" direction="in" value="CAMPO_1" />
          <param name="ReplaceString" direction="in" value="${var:var1}" />
          <param name="OutputString" direction="out" value="${var:phrase}" />
        </params>
        <returnValues />
      </step>
      <step id="Step16" name="String Substitute" component="Sytel.StepLibrary.StringSubstituteStep">
        <params>
          <param name="InputString" direction="in" value="${var:phrase}" />
          <param name="SearchString" direction="in" value="CAMPO_2" />
          <param name="ReplaceString" direction="in" value="${var:var2}" />
          <param name="OutputString" direction="out" value="${var:phrase}" />
        </params>
        <returnValues />
      </step>
      <step id="Step17" name="Pause" component="Sytel.StepLibrary.PauseStep">
        <params>
          <param name="Interval" direction="in" value="1" />
        </params>
        <returnValues />
      </step>
    </steps>
