  <!-- PAINEL LATERAL: RESUMO DO MOCCHI -->
  <Expander Name="expMocchiResumo"
            Header="Resumo do Mocchi"
            IsExpanded="True"
            ExpandDirection="Down"
            Width="330"
            Height="480"
            Margin="710,6,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="Verdana"
            FontSize="12"
            Foreground="#FF0B7895">
    <Border BorderBrush="#FF0B7895" BorderThickness="1" CornerRadius="6" Background="#FFF4FAFC" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
          <!-- SEÇÃO 1: IDENTIFICAÇÃO DO LEAD -->
          <Border Background="#FF0B7895" Padding="4" CornerRadius="3" Margin="0,0,0,6">
            <TextBlock Text="IDENTIFICAÇÃO DO LEAD" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="11" />
          </Border>
          <TextBlock Text="Cliente:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiNome" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="Empresa:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiEmpresa" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="Telefone:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiTelefone" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="E-mail:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiEmail" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,8" />

          <!-- SEÇÃO 2: NECESSIDADE & PRODUTOS -->
          <Border Background="#FF0B7895" Padding="4" CornerRadius="3" Margin="0,4,0,6">
            <TextBlock Text="PRODUTO &amp; INTERESSE" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="11" />
          </Border>
          <TextBlock Text="Produto Principal:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiProduto" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="Canais de Interesse:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiCanais" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,8" />

          <!-- SEÇÃO 3: DIMENSIONAMENTO DA OPERAÇÃO -->
          <Border Background="#FF0B7895" Padding="4" CornerRadius="3" Margin="0,4,0,6">
            <TextBlock Text="DIMENSIONAMENTO" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="11" />
          </Border>
          <TextBlock Text="Atendentes:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiAtendentes" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="Volume Mensal:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiVolume" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,8" />

          <!-- SEÇÃO 4: QUALIFICAÇÃO & URGÊNCIA -->
          <Border Background="#FF0B7895" Padding="4" CornerRadius="3" Margin="0,4,0,6">
            <TextBlock Text="QUALIFICAÇÃO SDR" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="11" />
          </Border>
          <TextBlock Text="Dor Principal:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiDor" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="Prazo:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiPrazo" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,4" />

          <TextBlock Text="Prioridade:" FontWeight="Bold" Foreground="#FF333333" FontSize="11" />
          <TextBlock Name="txtMocchiPrioridade" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,8" />

          <!-- SEÇÃO 5: RESUMO DA CONVERSA -->
          <Border Background="#FF0B7895" Padding="4" CornerRadius="3" Margin="0,4,0,6">
            <TextBlock Text="RESUMO DA CONVERSA (SDR)" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="11" />
          </Border>
          <TextBlock Name="txtMocchiResumo" TextWrapping="Wrap" Foreground="#FF000000" FontSize="11" Margin="0,0,0,8" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Expander>
</Grid>